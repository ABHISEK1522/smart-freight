# =============================================================================
# SMART FREIGHT — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or .env.local for local overrides. Do NOT commit real secrets.
# =============================================================================

# Backend Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# JWT Secret Key (HMAC-SHA256) — Set a secure random string in production
JWT_SECRET_KEY=smart_freight_dev_secret_key_change_in_production_2026

# OpenStreetMap & Routing Configuration (Nominatim & OSRM)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SmartFreight-Logistics/1.0 (contact@smartfreight.io)
OSRM_BASE_URL=http://router.project-osrm.org/route/v1/driving
OSRM_FALLBACK_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving
ROUTING_TIMEOUT_SECONDS=10

# Frontend Next.js API Gateway URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
